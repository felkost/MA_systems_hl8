.env
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
.idea/

# Per-machine assistant permission grants. Machine-specific and rewritten on
# every session; nothing here is part of the project.
.claude/

# Package and model caches kept inside the project so they land on drive F
# and disappear with a single `rm -rf .cache`.
.cache/

# Neo4j bind-mount data (stage 10). Recreated by `docker compose up`.
docker/

# Local-only working areas, by explicit decision (see CLAUDE.md): the test
# suite and the working notes/plan/reports.
tests/
docs/

# Vector index and BM25 corpus. Rebuilt by `python ingest.py`; a committed
# index would go stale against data/ with no signal that it had.
index/

# Logs from any run, experiment or evaluation.
*.log
logs/

# Markdown: only README.md and generated reports are tracked. Agent-facing
# docs (CLAUDE.md, AGENTS.md, CONTRIBUTING.md, insights.md, handoff.md,
# CHANGELOG.md) are local-only by explicit decision -- they never leave this
# machine, so every session must run from this same checkout.
*.md
!README.md
!.github/**/*.md
# The public technical report ships as both PDF and Markdown: GitHub renders
# the Markdown (mermaid diagrams and all) and the PDF is built from that same
# file. `report/` itself is not excluded, so this negation is reachable.
!report/*.md

# output/ holds generated reports. Ignore its contents, then re-include the
# reports and the placeholder: a stray .txt/.json from a crashed run must not
# be picked up by a broad `git add`. Ignoring `output/` itself instead would
# make these negations unreachable -- git cannot re-include a file whose
# parent directory is already excluded.
output/*
!output/.gitkeep
!output/*.md
