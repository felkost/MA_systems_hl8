# Copy this file to .env and fill in your values
# cp .env.example .env

OPENAI_API_KEY=sk-your-api-key-here
# Default model for the Supervisor and the Researcher. gpt-4.1-mini, not the
# hl5 reference's gpt-4o-mini -- the key already in use resolves this name.
MODEL_NAME=gpt-4.1-mini
# Per-agent overrides for the experiment "one model vs two" (stage 11).
# Empty means "use MODEL_NAME" -- set only the agent you are actually
# varying, never guess a second key/line into existence for the others.
PLANNER_MODEL_NAME=
CRITIC_MODEL_NAME=

# Which entry each agent's prompt registry runs on (see prompts.py from
# stage 2). An unregistered name is a hard error, never a silent fallback.
PLANNER_PROMPT_VERSION=p1
RESEARCHER_PROMPT_VERSION=r1
CRITIC_PROMPT_VERSION=c1
SUPERVISOR_PROMPT_VERSION=s1

# --- Agent runtime --------------------------------------------------------
TEMPERATURE=0.0
# Graph-level backstop; only fires if a tool-call limit somehow does not.
RECURSION_LIMIT=100
# Tool-call budgets, enforced by ToolCallLimitMiddleware per sub-agent
# (stages 2-4). The Planner's bound (4) is not exposed as a setting -- it is
# a small, fixed reconnaissance budget, not a tunable the experiments vary.
RESEARCHER_MAX_TOOL_CALLS=8
CRITIC_MAX_TOOL_CALLS=5
# How many revision rounds the Critic may send the Researcher back for
# (both the supervisor and the explicit-graph orchestration path enforce
# this as a hard cap, not a prompt instruction). The assignment's own
# number; stage 11 measures whether 1 changes anything before touching it.
MAX_REVISIONS=2
# supervisor (agent-as-tool, as the assignment prescribes) or graph (the
# explicit StateGraph orchestrator added in stage 7). Same public interface
# either way -- see main.py --orchestration.
ORCHESTRATION=supervisor
# Pages read_url may open before the next search. Uncapped, hl5 measured a
# single search spawning up to seven page reads with no report at the end;
# capping it at 2 took the share of runs that reach a saved report from 0.08
# to 0.58 with no other metric worse. Empty removes the cap.
MAX_READ_URL_PER_SEARCH=2
MAX_SEARCH_RESULTS=5
MAX_SEARCH_SNIPPET_LENGTH=500
MAX_URL_CONTENT_LENGTH=5000
HTTP_TIMEOUT_SECONDS=10.0
OUTPUT_DIR=output

# --- Knowledge base (RAG) -------------------------------------------------
# Read by ingest.py. Changing any of them invalidates the index: ingest.py
# records them in index/manifest.json and retriever.py refuses an index
# built with different values.
EMBEDDING_MODEL=text-embedding-3-small
# Matryoshka truncation of the embedding vector. Empty keeps the model's
# native width (1536 for text-embedding-3-small).
# EMBEDDING_DIMENSIONS=
DATA_DIR=data
INDEX_DIR=index
COLLECTION_NAME=knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Retrieval -------------------------------------------------------------
# Read by retriever.py. The index does not have to be rebuilt when these
# change: they shape the query, not the stored vectors.
RERANKER_MODEL=BAAI/bge-reranker-base
# auto | cpu | cuda. "auto" picks cuda when torch reports a device. Anything
# else is a startup error rather than a silent fall back to the CPU.
RERANKER_DEVICE=auto
# Candidates per ensemble arm (semantic and BM25), so up to 2x this many
# reach the cross-encoder, which then keeps RERANK_TOP_N. Recall lost here
# is unrecoverable -- the reranker only reorders what it was given -- while
# an extra candidate costs milliseconds of GPU time.
RETRIEVAL_TOP_K=20
RERANK_TOP_N=3
# Weight of the lexical arm when the two rankings are fused; the semantic arm
# gets the remainder. 0.4 favours embeddings while still letting an exact
# rare term (a model name, an acronym) survive.
ENSEMBLE_BM25_WEIGHT=0.4
# Where the reranker model is downloaded to. Kept inside the checkout so it
# lands on the same drive and `rm -rf .cache` removes every model at once.
# retriever.py exports this, overriding any ambient HF_HOME: Settings decides,
# not whatever another project left in the environment.
MODEL_CACHE_DIR=.cache/models

# --- Knowledge graph (stage 10) --------------------------------------------
# Read by graph.py, the graph_search tool (Researcher only) and
# `ingest.py --graph`. The agent starts fine with these unset -- only
# graph_search and `ingest.py --graph` need them, the same way a missing
# index only disables knowledge_search.
# docker-compose.yml requires NEO4J_PASSWORD to start the container; set it
# here to the same value before running `docker compose up -d neo4j`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
MAX_GRAPH_SEARCH_LENGTH=2000

# --- Evaluation (stage 9) ---------------------------------------------------
# Name of the LangSmith dataset evals/upload_dataset.py creates and
# evals/run_eval.py reads examples from. Both must agree, hence one setting.
EVAL_DATASET_NAME=research-agent-hl8-eval
SUBAGENT_EVAL_DATASET_NAME=research-agent-hl8-subagents

# --- LangSmith tracing -----------------------------------------------------
# With LANGSMITH_TRACING unset or false the agent sends nothing anywhere.
# Note: pydantic-settings parses .env without exporting anything, while the
# LangSmith SDK reads os.environ only -- a key that lives only here produces
# zero traces, in silence, until something copies the values across
# (tracing.configure_tracing does exactly that).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=research-agent-hl8
# A key only works in the region that issued it. EU:
# https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Needed only for an organization-scoped key. A personal key ignores this.
# LANGSMITH_WORKSPACE_ID=
